# HeyMail — SAFE example configuration.
# Copy this file to .env for local development.
# NEVER put real production secrets in this example file.

COMPOSE_PROJECT_NAME=heymail
APP_ENV=dev
HEYMAIL_DOMAIN=heymail.local
HEYMAIL_API_HOST=api.heymail.local
HEYMAIL_WEB_HOST=app.heymail.local

# Non-secret development defaults only.
POSTGRES_DB=heymail
POSTGRES_USER=heymail_admin

# Passwords, encryption keys, DKIM private keys and API tokens
# will be provided through files under ./secrets/ and Docker secrets.

# UID/GID used by short-lived unprivileged infrastructure helpers.
# Adapt in the local .env when the deployment user uses different IDs.
HEYMAIL_UID=1000
HEYMAIL_GID=1000
