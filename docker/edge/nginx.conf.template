worker_processes auto;

pid /tmp/nginx.pid;

error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    access_log /dev/stdout;

    server_tokens off;

    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;

    # -----------------------------------------------------
    # Public API
    # Host loopback: 3041
    # -----------------------------------------------------

    server {
        listen 8080;

        client_max_body_size 3500k;

        add_header
            X-Content-Type-Options
            nosniff
            always;

        add_header
            X-Frame-Options
            DENY
            always;

        add_header
            Referrer-Policy
            no-referrer
            always;

        location = /health {
            return 204;
        }

        location / {
            include /etc/nginx/fastcgi_params;

            fastcgi_param
                SCRIPT_FILENAME
                /app/public/index.php;

            fastcgi_param
                SCRIPT_NAME
                /index.php;

            fastcgi_param
                DOCUMENT_ROOT
                /app/public;

            fastcgi_param
                HTTPS
                on;

            fastcgi_param
                REQUEST_SCHEME
                https;

            fastcgi_param
                HTTP_AUTHORIZATION
                $http_authorization;

            fastcgi_param
                HTTP_IDEMPOTENCY_KEY
                $http_idempotency_key;

            fastcgi_param
                HTTP_ACCEPT
                $http_accept;

            fastcgi_connect_timeout 3s;
            fastcgi_read_timeout 30s;

            fastcgi_pass
                unix:/run/heymail-fpm/heymail.sock;
        }
    }

    # -----------------------------------------------------
    # Operator console
    # Host loopback: 3040
    # -----------------------------------------------------

    server {
        listen 8081;

        root /srv/heymail;

        index index.html;

        client_max_body_size 3500k;

        auth_basic
            "HeyMail Console";

        auth_basic_user_file
            /run/secrets/console_htpasswd;

        add_header
            X-Content-Type-Options
            nosniff
            always;

        add_header
            X-Frame-Options
            DENY
            always;

        add_header
            Referrer-Policy
            no-referrer
            always;

        location = /health {
            auth_basic off;
            return 204;
        }

        location /api/ {
            include /etc/nginx/fastcgi_params;

            fastcgi_param
                SCRIPT_FILENAME
                /app/public/index.php;

            fastcgi_param
                SCRIPT_NAME
                /index.php;

            fastcgi_param
                DOCUMENT_ROOT
                /app/public;

            fastcgi_param
                HTTPS
                on;

            fastcgi_param
                REQUEST_SCHEME
                https;

            fastcgi_param
                HTTP_AUTHORIZATION
                "Basic __API_BASIC__";

            fastcgi_param
                HTTP_IDEMPOTENCY_KEY
                $http_idempotency_key;

            fastcgi_param
                HTTP_ACCEPT
                $http_accept;

            fastcgi_connect_timeout 3s;
            fastcgi_read_timeout 30s;

            fastcgi_pass
                unix:/run/heymail-fpm/heymail.sock;
        }

        location /assets/ {
            try_files $uri =404;

            expires 1y;

            add_header
                Cache-Control
                "public, immutable";
        }

        location / {
            try_files
                $uri
                $uri/
                /index.html;

            add_header
                Cache-Control
                "no-store";
        }
    }
}
