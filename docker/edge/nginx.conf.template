worker_processes auto;

pid /tmp/nginx.pid;

error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    access_log /dev/stdout;

    server_tokens off;

    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    limit_req_zone
        $binary_remote_addr
        zone=heymail_console_login:10m
        rate=5r/m;

    # -----------------------------------------------------
    # Public API
    # Host loopback: 3041
    # -----------------------------------------------------

    server {
        listen 8080;

        client_max_body_size 3500k;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;

        location = /health {
            return 204;
        }

        location / {
            include /etc/nginx/fastcgi_params;

            fastcgi_param SCRIPT_FILENAME /app/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param DOCUMENT_ROOT /app/public;
            fastcgi_param HTTPS on;
            fastcgi_param REQUEST_SCHEME https;
            fastcgi_param HTTP_HOST $http_host;
            fastcgi_param HTTP_AUTHORIZATION $http_authorization;
            fastcgi_param HTTP_IDEMPOTENCY_KEY $http_idempotency_key;
            fastcgi_param HTTP_ACCEPT $http_accept;
            fastcgi_param HTTP_ORIGIN $http_origin;
            fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site;

            fastcgi_connect_timeout 3s;
            fastcgi_read_timeout 30s;

            fastcgi_pass unix:/run/heymail-fpm/heymail.sock;
        }
    }

    # -----------------------------------------------------
    # Operator console
    # Host loopback: 3040
    # -----------------------------------------------------

    server {
        listen 8081;

        root /srv/heymail;
        index index.html;

        client_max_body_size 3500k;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;

        location = /health {
            return 204;
        }

        location = /heymail-logo.svg {
            try_files $uri =404;
            expires 1h;
        }

        location /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        location = /login {
            try_files /index.html =404;
            add_header Cache-Control "no-store";
        }

        location = /_console_auth_check {
            internal;

            include /etc/nginx/fastcgi_params;

            fastcgi_param SCRIPT_FILENAME /app/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param DOCUMENT_ROOT /app/public;
            fastcgi_param REQUEST_METHOD GET;
            fastcgi_param REQUEST_URI /console/auth/check;
            fastcgi_param QUERY_STRING "";
            fastcgi_param HTTPS on;
            fastcgi_param REQUEST_SCHEME https;
            fastcgi_param HTTP_HOST $http_host;
            fastcgi_param HTTP_COOKIE $http_cookie;
            fastcgi_param HTTP_ACCEPT application/json;
            fastcgi_param HTTP_ORIGIN $http_origin;
            fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site;

            fastcgi_pass unix:/run/heymail-fpm/heymail.sock;
        }

        location = /console/auth/login {
            limit_req zone=heymail_console_login burst=3 nodelay;
            limit_req_status 429;

            include /etc/nginx/fastcgi_params;

            fastcgi_param SCRIPT_FILENAME /app/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param DOCUMENT_ROOT /app/public;
            fastcgi_param HTTPS on;
            fastcgi_param REQUEST_SCHEME https;
            fastcgi_param HTTP_HOST $http_host;
            fastcgi_param HTTP_COOKIE $http_cookie;
            fastcgi_param HTTP_ACCEPT $http_accept;
            fastcgi_param HTTP_ORIGIN $http_origin;
            fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site;

            fastcgi_connect_timeout 3s;
            fastcgi_read_timeout 30s;

            fastcgi_pass unix:/run/heymail-fpm/heymail.sock;
        }

        location /console/ {
            include /etc/nginx/fastcgi_params;

            fastcgi_param SCRIPT_FILENAME /app/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param DOCUMENT_ROOT /app/public;
            fastcgi_param HTTPS on;
            fastcgi_param REQUEST_SCHEME https;
            fastcgi_param HTTP_HOST $http_host;
            fastcgi_param HTTP_COOKIE $http_cookie;
            fastcgi_param HTTP_ACCEPT $http_accept;
            fastcgi_param HTTP_ORIGIN $http_origin;
            fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site;

            fastcgi_connect_timeout 3s;
            fastcgi_read_timeout 30s;

            fastcgi_pass unix:/run/heymail-fpm/heymail.sock;
        }

        location /api/ {
            auth_request /_console_auth_check;
            error_page 401 = @console_api_unauthorized;

            include /etc/nginx/fastcgi_params;

            fastcgi_param SCRIPT_FILENAME /app/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param DOCUMENT_ROOT /app/public;
            fastcgi_param HTTPS on;
            fastcgi_param REQUEST_SCHEME https;
            fastcgi_param HTTP_HOST $http_host;
            fastcgi_param HTTP_AUTHORIZATION "Basic __API_BASIC__";
            fastcgi_param HTTP_IDEMPOTENCY_KEY $http_idempotency_key;
            fastcgi_param HTTP_ACCEPT $http_accept;
            fastcgi_param HTTP_ORIGIN $http_origin;
            fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site;

            fastcgi_connect_timeout 3s;
            fastcgi_read_timeout 30s;

            fastcgi_pass unix:/run/heymail-fpm/heymail.sock;
        }

        location @console_api_unauthorized {
            default_type application/json;
            return 401 '{"error":{"code":"console_unauthorized","message":"Console authentication required."}}';
        }

        location @console_login_redirect {
            return 302 /login;
        }

        location / {
            auth_request /_console_auth_check;
            error_page 401 = @console_login_redirect;

            try_files
                $uri
                $uri/
                /index.html;

            add_header Cache-Control "no-store";
        }
    }
}
